/* Kontainer lintasan: background tetap diam */
.track-container {
  position: relative;
  width: 100%;
  height: 70px;
  background-color: aquamarine;
  overflow: hidden;
  display: flex;
  align-items: center;
  container-type: inline-size; /* Mengukur lebar frame kontainer */
}

/* Teks yang memantul di dalam lintasan */
.track-text {
  position: absolute;
  left: 0;
  white-space: nowrap;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #c71919;
  /* ease-in-out membuat efek deselerasi halus saat memantul */
  animation: bounceText 4s ease-in-out infinite alternate;
}

/* Gerakan bolak-balik di dalam frame */
@keyframes bounceText {
  0% {
    /* Menempel di ujung kiri frame */
    transform: translateX(0);
  }
  100% {
    /* Bergerak ke ujung kanan frame tanpa terpotong keluar */
    transform: translateX(calc(100cqw - 100%));
  }
}
